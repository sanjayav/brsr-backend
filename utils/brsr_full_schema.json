{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Full BRSR Report Schema",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "description": "Registered name of the company"
    },
    "financialYear": {
      "type": "string",
      "description": "The financial year of the report (e.g., '2023-24')"
    },
    "sectionA": {
      "type": "object",
      "description": "Section A - General Disclosures",
      "properties": {
        "A1": {
          "type": "string",
          "description": "Name of the Company"
        },
        "A2": {
          "type": "string",
          "description": "CIN"
        },
        "A3": {
          "type": "string",
          "description": "Registered address"
        },
        "A4": {
          "type": "string",
          "description": "Corporate address"
        },
        "A5": {
          "type": "string",
          "description": "Email"
        }
      },
      "required": [
        "A1",
        "A2"
      ]
    },
    "sectionB": {
      "type": "object",
      "description": "Section B - Management and Process Disclosures",
      "properties": {
        "B1": {
          "type": "string",
          "description": "Governance structure of the entity"
        },
        "B2": {
          "type": "string",
          "description": "Policy related to responsible business conduct"
        },
        "B3": {
          "type": "string",
          "description": "Stakeholder complaints and redressal mechanism"
        }
      },
      "required": [
        "B1"
      ]
    },
    "sectionC": {
      "type": "object",
      "description": "Section C - Principle-wise Performance Disclosures",
      "properties": {
        "C1_P1_Q1": {
          "type": "string",
          "description": "Question 1 of Principle 1"
        },
        "C1_P1_Q2": {
          "type": "string"
        },
        "C1_P2_Q1": {
          "type": "string"
        },
        "C1_P2_Q2": {
          "type": "string"
        },
        "C1_P6_Q4": {
          "type": "string"
        },
        "C1_P9_Q5": {
          "type": "string"
        }
      }
    },
    "signatories": {
      "type": "array",
      "description": "List of signatories who approved the report",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "signed": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "role",
          "date",
          "signed"
        ]
      }
    }
  },
  "required": [
    "company",
    "financialYear",
    "sectionA",
    "sectionB",
    "sectionC"
  ]
}